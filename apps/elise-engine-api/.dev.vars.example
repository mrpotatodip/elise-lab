ENVIRONMENT=development
SCAN_API_TOKEN=
ANTHROPIC_API_KEY=
# Optional: lets an account save its own Anthropic key. Any long random string.
KEY_ENCRYPTION_SECRET=
# Required: locks every Account's Data key (ADR 0018). 32 random bytes in base64: `openssl rand -base64 32`. Keep a copy in a second secret store: lose it and every Account's sealed text is lost.
DATA_MASTER_KEY=
# Stripe, test mode first: the secret key and the webhook endpoint's signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: TypeSafe's key for Signals (hints about Findings). Without it no Signal is made.
TYPESAFE_API_KEY=
# Sign-up checks a Cloudflare Turnstile token. Without this secret every sign-up is refused.
# This is Cloudflare's published always-pass test secret; the dashboard's matching test site key is 1x00000000000000000000AA.
# Always-fail pair: secret 2x0000000000000000000000000000000AA, site key 2x00000000000000000000AB.
# Production: `wrangler secret put TURNSTILE_SECRET_KEY` with the real widget's secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# The dashboard sends its own origin on the Two-factor second step (the engine refuses a cookie call with none). The deployed list lacks the local dashboard port.
AUTH_TRUSTED_ORIGINS=https://api.eliselab.com,https://app.eliselab.com,http://localhost:3000,http://localhost:3100
DATABASE_URL=
AUTH_SECRET=
