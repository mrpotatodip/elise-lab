---
// The Elise mark, copied from the dashboard (apps/elise-frontend-web, modules/shell,
// shell-logo.tsx): an "E" of three bars in a diamond, drawn with the theme's action
// colours so it is dark on a light page and light on a dark one. Decorative: the
// name always sits next to it.
const { class: className } = Astro.props;
---

<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false" class={className}>
  <rect x="4" y="4" width="24" height="24" rx="5" transform="rotate(45 16 16)" fill="var(--primary)"></rect>
  <g fill="var(--primary-foreground)" transform="rotate(-45 16 16) translate(16 16) scale(0.8) translate(-16 -16)">
    <rect x="9" y="8" width="4" height="16"></rect>
    <rect x="9" y="8" width="14" height="4"></rect>
    <rect x="9" y="14" width="14" height="4"></rect>
    <rect x="9" y="20" width="14" height="4"></rect>
  </g>
</svg>
