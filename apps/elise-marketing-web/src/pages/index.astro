---
import Base from "../layouts/Base.astro";
import Logo from "../layouts/Logo.astro";
import ThemeSelect from "../layouts/ThemeSelect.astro";
import ScansCard from "../stageshow/ScansCard";
import { AuditStep, ConnectStep, ReportStep } from "../stageshow/Steps";
import { CLOSING, CLOUDFLARE_SKILL_URL, FACTS, HERO_HINT, LEDE, OPEN_SOURCE, PICTURE_LABELS, PRICING, RUNNER, SHOWCASE_CAPTION, SITE, SOURCE_URL, STEPS, STEPS_NOTE } from "../constants/site";
---

<Base>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="wrap">
    <header class="nav">
      <a class="brand" href="/">
        <Logo class="brand-mark" />
        {SITE.logoName}
      </a>
      <nav class="nav-links" aria-label="On this page">
        <a href="#how-it-works">How it works</a>
        <a href="#get-the-runner">Get the Runner</a>
        <a href="#pricing">Pricing</a>
        <a href="#open-source">Open source</a>
        <a href="#what-to-know">What to know</a>
      </nav>
      <div class="nav-actions">
        <a class="button outline" href={SITE.appUrl}>Sign in</a>
      </div>
    </header>

    <main id="main">
      <div class="hero">
        <h1>Security agents that read your code before an attacker does.</h1>
        <div class="hero-row">
          <p class="lede">{LEDE.start}<a href={CLOUDFLARE_SKILL_URL} rel="noopener">{LEDE.link}</a>{LEDE.middle}<a href="#what-to-know">{LEDE.rulesLink}</a>{LEDE.end}</p>
          <div class="hero-cta">
            <div class="actions">
              <a class="button lg" href={SITE.appUrl}>Audit a repository</a>
              <a class="button lg outline" href="#how-it-works">How it works</a>
            </div>
            <p class="hint">{HERO_HINT}</p>
          </div>
        </div>
        <p class="hint">{OPEN_SOURCE.heroLine} <a href={SOURCE_URL} rel="noopener">{OPEN_SOURCE.heroLink}</a>.</p>
      </div>

      <figure class="showcase" aria-labelledby="showcase-caption">
        <div class="frame frame--tour" role="img" aria-label={PICTURE_LABELS.tour}>
          <div aria-hidden="true"><ScansCard client:idle /></div>
        </div>
        <figcaption>
          <span id="showcase-caption">{SHOWCASE_CAPTION}</span>
          <button type="button" class="button outline" id="motion-toggle">Pause animations</button>
        </figcaption>
      </figure>

      <section id="how-it-works" aria-labelledby="how-heading">
        <h2 id="how-heading">How it works</h2>
        <p class="section-note">{STEPS_NOTE}</p>
        <ol class="steps">
          <li>
            <div class="step-text">
              <h3>{STEPS[0].title}</h3>
              <p>{STEPS[0].text}</p>
              <ul>{STEPS[0].points.map((point) => <li>{point}</li>)}</ul>
            </div>
            <div class="step-fig frame frame--connect" role="img" aria-label={PICTURE_LABELS.connect}><div aria-hidden="true"><ConnectStep client:visible /></div></div>
          </li>
          <li>
            <div class="step-text">
              <h3>{STEPS[1].title}</h3>
              <p>{STEPS[1].text}</p>
              <ul>{STEPS[1].points.map((point) => <li>{point}</li>)}</ul>
            </div>
            <div class="step-fig frame frame--audit" role="img" aria-label={PICTURE_LABELS.audit}><div aria-hidden="true"><AuditStep client:visible /></div></div>
          </li>
          <li>
            <div class="step-text">
              <h3>{STEPS[2].title}</h3>
              <p>{STEPS[2].text}</p>
              <ul>{STEPS[2].points.map((point) => <li>{point}</li>)}</ul>
            </div>
            <div class="step-fig frame frame--report" role="img" aria-label={PICTURE_LABELS.report}><div aria-hidden="true"><ReportStep client:visible /></div></div>
          </li>
        </ol>
      </section>

      <section id="get-the-runner" aria-labelledby="runner-heading">
        <h2 id="runner-heading">{RUNNER.title}</h2>
        <p class="section-note">{RUNNER.note}</p>
        <p class="runner-install__label" id="runner-downloads-label">{RUNNER.downloadsLabel}</p>
        <div class="runner-downloads" role="group" aria-labelledby="runner-downloads-label">
          {RUNNER.downloads.map((file) => <a class="button outline lg" href={file.href} rel="noopener">{file.label}</a>)}
        </div>
        <p class="section-note">{RUNNER.downloadNote.map((part) => (typeof part === "string" ? part : <code>{part.code}</code>))}</p>
        <div class="runner-install">
          <p class="runner-install__label" id="runner-command-label">{RUNNER.commandLabel}</p>
          <pre class="runner-install__command" tabindex="0" aria-labelledby="runner-command-label"><code>{RUNNER.command}</code></pre>
        </div>
        <p class="section-note">{RUNNER.after.map((part) => (typeof part === "string" ? part : <code>{part.code}</code>))}</p>
        <p class="section-note">{RUNNER.needs}</p>
        <p class="section-note"><a href={RUNNER.releasesUrl} rel="noopener">{RUNNER.releasesLabel}</a></p>
      </section>

      <section id="pricing" aria-labelledby="pricing-heading">
        <h2 id="pricing-heading">Pricing</h2>
        <p class="section-note">{PRICING.note}</p>
        <div class="billing">
          <input class="sr-only" type="radio" name="billing" id="billing-month" value="month" checked />
          <input class="sr-only" type="radio" name="billing" id="billing-year" value="year" />
          <div class="billing-toggle" role="group" aria-label="Billing interval">
            <label for="billing-month">{PRICING.intervals.month}</label>
            <label for="billing-year">{PRICING.intervals.year} <span class="billing-badge">{PRICING.yearlyBadge}</span></label>
          </div>
          <div class="plans">
            {
              PRICING.plans.map((plan) => (
                <article class="plan">
                  <h3>{plan.name}</h3>
                  <p class="plan-price when-month">
                    {plan.price}
                    <span>per month</span>
                  </p>
                  <p class="plan-price when-year">
                    {plan.yearlyPrice}
                    <span>per year, {plan.yearlyPerMonth} a month</span>
                  </p>
                  <p class="plan-summary">{plan.summary}</p>
                  <ul>{plan.points.map((point) => <li>{point}</li>)}</ul>
                </article>
              ))
            }
          </div>
        </div>
        <div class="plans-action">
          <a class="button outline" href={SITE.signUpUrl}>{PRICING.action}</a>
          <p class="hint">{PRICING.actionHint}</p>
        </div>
      </section>

      <section id="open-source" aria-labelledby="open-source-heading">
        <h2 id="open-source-heading">{OPEN_SOURCE.title}</h2>
        <p class="section-note">{OPEN_SOURCE.note}</p>
        <div class="facts">
          {
            OPEN_SOURCE.points.map((point) => (
              <div>
                <h3>{point.title}</h3>
                <p>{point.text}</p>
              </div>
            ))
          }
        </div>
        <div class="plans-action">
          <a class="button outline" href={SOURCE_URL} rel="noopener">{OPEN_SOURCE.repoLabel}</a>
          <p class="hint"><a href="/open-source">{OPEN_SOURCE.pageLink}</a></p>
        </div>
      </section>

      <section id="what-to-know" aria-labelledby="know-heading">
        <h2 id="know-heading">What to know</h2>
        <div class="facts">
          {
            FACTS.map((fact) => (
              <div>
                <h3>{fact.title}</h3>
                <p>
                  {fact.text}
                  {"more" in fact && <> <a href={fact.more.href}>{fact.more.label}</a></>}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="closing" aria-labelledby="cta-heading">
        <h2 id="cta-heading">{CLOSING.title}</h2>
        <p><a href={SITE.signUpUrl}>{CLOSING.signUp}</a>{CLOSING.text} <a href="#pricing">{CLOSING.link}</a></p>
        <a class="button lg" href={SITE.appUrl}>Audit a repository</a>
        <p class="hint">{CLOSING.hint}</p>
      </section>
    </main>
  </div>

  <footer>
    <div class="wrap footer-row">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <nav class="footer-links" aria-label="Footer">
        <a href="#how-it-works">How it works</a>
        <a href="#pricing">Pricing</a>
        <a href="#what-to-know">What to know</a>
        <a href="/open-source">Open source</a>
        <a href={SOURCE_URL} rel="noopener">GitHub</a>
        <a href={CLOUDFLARE_SKILL_URL} rel="noopener">Cloudflare's open-source security-audit method</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href={SITE.appUrl}>Sign in</a>
      </nav>
      <ThemeSelect />
    </div>
  </footer>

  <script>
    // A picture of the app stays invisible until its island has hydrated and two frames have passed,
    // so its first layout (the wide one, then the narrow one) is never painted and never shifts.
    const reveal = (island: Element) => {
      const frame = island.closest(".frame");
      if (!frame) return;
      requestAnimationFrame(() => requestAnimationFrame(() => frame.setAttribute("data-ready", "")));
    };
    document.querySelectorAll("astro-island").forEach((island) => {
      if (!island.hasAttribute("ssr")) reveal(island);
      else island.addEventListener("astro:hydrate", () => reveal(island), { once: true });
    });
  </script>

  <script>
    // "Pause animations": the pictures play once as they scroll into view. This keeps them still.
    const KEY = "elise.motion";
    const toggle = document.querySelector<HTMLButtonElement>("#motion-toggle");
    if (toggle) {
      const off = document.documentElement.dataset.motion === "off";
      toggle.textContent = off ? "Play animations" : "Pause animations";
      toggle.addEventListener("click", () => {
        try {
          if (off) localStorage.removeItem(KEY);
          else localStorage.setItem(KEY, "off");
        } catch {
          // Without storage the choice cannot be kept, so there is nothing to reload.
          return;
        }
        location.reload();
      });
    }
  </script>
</Base>
